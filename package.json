{
  "name": "cliuno",
  "displayName": "CLIuno",
  "description": "Scaffold a full-stack app from CLIuno's contract-tested templates — pick a stack, get a working project.",
  "version": "2.1.2",
  "publisher": "cliuno",
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.png",
  "homepage": "https://github.com/CLIuno/CLIuno-Vscode-Extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CLIuno/CLIuno-Vscode-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/CLIuno/CLIuno-Vscode-Extension/issues"
  },
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "scaffold",
    "starter",
    "full-stack",
    "template",
    "generator"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cliuno.scaffold",
        "title": "Scaffold a new app",
        "category": "CLIuno"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3"
  }
}
